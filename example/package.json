{
  "name": "react-native-gradient-mask-example",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "open:android": "open -a \"Android Studio\" android",
    "typecheck": "tsc --noEmit",
    "export:native": "expo export --platform ios --platform android",
    "prebuild": "expo prebuild --template expo-template-bare-minimum@56.0.35",
    "preios": "npm run prebuild -- --platform ios",
    "preandroid": "npm run prebuild -- --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@shopify/flash-list": "2.3.1",
    "expo": "56.0.17",
    "expo-blur": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-gradient-mask": "file:..",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.8.3",
    "expo-font": "56.0.7",
    "expo-system-ui": "56.0.5",
    "expo-splash-screen": "56.0.14",
    "expo-modules-jsi": "56.0.12"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "6.0.3",
    "babel-preset-expo": "56.0.18"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    },
    "install": {
      "exclude": [
        "expo",
        "@shopify/flash-list",
        "expo-splash-screen"
      ]
    }
  },
  "worklets": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "overrides": {
    "expo-modules-core": "56.0.22"
  }
}
